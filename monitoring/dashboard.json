    {
      "type": "log",
      "x": 0,
      "y": 21,
      "width": 24,
      "height": 7,
      "properties": {
        "title": "FRAUD decisions, newest first (deduplicated)",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/fraud/audit/fraud-rf-endpoint' | fields @timestamp, transaction_id, fraud_score, confidence, request_id | filter event = \"prediction\" and decision = \"FRAUD\" | sort @timestamp desc | dedup request_id, transaction_id"
      }
