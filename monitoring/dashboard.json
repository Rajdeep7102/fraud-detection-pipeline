{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "## Fraud detection endpoint `fraud-rf-endpoint`\nTraffic and health (row 1), model behaviour from the JSON audit log (row 2), drift from the PSI job (row 3), recent flagged transactions (row 4). Audit-log metrics lag a few minutes; PSI points appear when `monitoring/drift_job.py` runs."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Invocations",
        "region": "us-east-1",
        "metrics": [
          [
            "AWS/SageMaker",
            "Invocations",
            "EndpointName",
            "fraud-rf-endpoint",
            "VariantName",
            "AllTraffic",
            {
              "stat": "Sum"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 2,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Model latency (ms)",
        "region": "us-east-1",
        "metrics": [
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "fraud-rf-endpoint",
            "VariantName",
            "AllTraffic",
            {
              "id": "m1",
              "stat": "Average",
              "visible": false
            }
          ],
          [
            "AWS/SageMaker",
            "ModelLatency",
            "EndpointName",
            "fraud-rf-endpoint",
            "VariantName",
            "AllTraffic",
            {
              "id": "m2",
              "stat": "p99",
              "visible": false
            }
          ],
          [
            {
              "expression": "m1 / 1000",
              "label": "average",
              "id": "e1"
            }
          ],
          [
            {
              "expression": "m2 / 1000",
              "label": "p99",
              "id": "e2"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 2,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Errors",
        "region": "us-east-1",
        "metrics": [
          [
            "AWS/SageMaker",
            "Invocation5XXErrors",
            "EndpointName",
            "fraud-rf-endpoint",
            "VariantName",
            "AllTraffic",
            {
              "stat": "Sum",
              "label": "5XX"
            }
          ],
          [
            "FraudDetection",
            "RequestRejectedCount",
            {
              "stat": "Sum",
              "label": "rejected (400)"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Model confidence",
        "region": "us-east-1",
        "metrics": [
          [
            "FraudDetection",
            "ModelConfidence",
            {
              "stat": "Average",
              "label": "average"
            }
          ],
          [
            "FraudDetection",
            "ModelConfidence",
            {
              "stat": "p10",
              "label": "p10"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "annotations": {
          "horizontal": [
            {
              "label": "alarm",
              "value": 0.6
            }
          ]
        },
        "yAxis": {
          "left": {
            "min": 0.5,
            "max": 1
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Flagged as FRAUD (%)",
        "region": "us-east-1",
        "metrics": [
          [
            "FraudDetection",
            "FraudFlagCount",
            {
              "id": "m1",
              "stat": "Sum",
              "visible": false
            }
          ],
          [
            "FraudDetection",
            "PredictionCount",
            {
              "id": "m2",
              "stat": "Sum",
              "visible": false
            }
          ],
          [
            {
              "expression": "IF(m2 > 0, 100 * m1 / m2, 0)",
              "label": "% flagged",
              "id": "e1"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "period": 300,
        "stat": "Average",
        "annotations": {
          "horizontal": [
            {
              "label": "alarm (3x test-set rate)",
              "value": 0.594
            }
          ]
        }
      }
    },
